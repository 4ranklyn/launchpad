    <!-- Client Script: Wordmark Social Tray & Cross-Device Predictable Drawer Expansion -->
    <script>
      // Wordmark Social Tray Hover / Click logic
      const anchor = document.getElementById('wordmark-anchor');
      const tray = document.getElementById('social-tray');
      const trigger = document.getElementById('social-trigger');

      if (anchor && tray && trigger) {
        let timer: number | null = null;
        let isOpen = false;

        const setOpen = (open: boolean) => {
          isOpen = open;
          if (open) {
            tray.classList.add('is-open');
            trigger.classList.add('active');
            trigger.setAttribute('aria-expanded', 'true');
          } else {
            tray.classList.remove('is-open');
            trigger.classList.remove('active');
            trigger.setAttribute('aria-expanded', 'false');
          }
        };

        const openBar = () => {
          setOpen(true);
        };

        const closeBar = () => {
          setOpen(false);
        };

        anchor.addEventListener('mouseenter', openBar);
        anchor.addEventListener('mouseleave', closeBar);

        trigger.addEventListener('click', (e) => {
          const selection = window.getSelection();
          if (selection && selection.toString().trim().length > 0) return;
          e.stopPropagation();
          setOpen(!isOpen);
        });

        trigger.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            setOpen(!isOpen);
          }
        });

        document.addEventListener('pointerdown', (e) => {
          if (!isOpen) return;
          if (!anchor.contains(e.target as Node)) {
            setOpen(false);
          }
        });
      }

      // Universal Click / Tap Expansion for all devices without redirect collision
      const expandableItems = document.querySelectorAll('[data-expandable]');
      expandableItems.forEach((item) => {
        item.addEventListener('click', (e) => {
          const target = e.target as HTMLElement | null;
          // If clicking an explicit anchor link or interactive control, allow default navigation
          if (target && target.closest('a')) {
            return;
          }
          item.classList.toggle('is-expanded');
        });
      });
    </script>
